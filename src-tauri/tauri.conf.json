{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeddleLab",
  "version": "0.3.4",
  "identifier": "io.heddlelab.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HeddleLab — Handweaving Studio",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "RWQ7UBoGJJKnzy4PVQWoEl3H31xkdFuvlcwNaBopJ9s22UIOuML4EtNu",
      "endpoints": [
        "https://github.com/PatrickBarbian/HeddleLab/releases/latest/download/latest.json"
      ]
    }
  }
}
